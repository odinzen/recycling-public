&CONTROL
   calculation      = 'vc-relax'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './out'
   prefix           = 'ref_TiO2_rutile'
   pseudo_dir       = '/scratch/mebusta3/ti-dft/pseudo'
/
&SYSTEM
   ecutwfc          = 60.0
   ecutrho          = 480.0
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'mp'
   ntyp             = 2
   nat              = 6
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-07
   mixing_beta      = 0.3
/
&IONS
   ion_dynamics     = 'bfgs'
/
&CELL
   cell_dynamics    = 'bfgs'
/
